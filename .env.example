# Copiar a .env y rellenar. El archivo .env no se sube al repositorio.

# --- Obligatorias ---
DB_PASSWORD=
# Primer administrador; solo se usan mientras no exista ninguno. Contraseña de 10 caracteres o más.
APP_ADMIN_EMAIL=
APP_ADMIN_PASSWORD=

# --- Sitio ---
# URL pública (sin barra final). Se usa en los correos y al volver del login social.
APP_BASE_URL=http://localhost:4000
# Dominios del sitio, separados por comas (p. ej. academia.midominio.com).
SITE_HOSTS=localhost
# true cuando el sitio se sirva por HTTPS.
SESSION_COOKIE_SECURE=false

# --- Correo (opcional). Sin MAIL_HOST los enlaces de verificación se escriben en el log de la API ---
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=

# --- Login social (opcional). Cada proveedor se activa al rellenar su client id ---
# URL de retorno a registrar en cada proveedor: <APP_BASE_URL>/login/oauth2/code/<google|github|discord>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
